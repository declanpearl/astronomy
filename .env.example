# Copy this file to .env.local and fill in YOUR Supabase project values. .env.local is ignored by Git.
# Use ONLY the public "anon" / "publishable" key. NEVER use the service_role or secret key (the app refuses it).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
